{
    "name": "installer-worker",
    "main": "build/worker.mjs",
    "compatibility_date": "2024-09-14",
    "build": {
        "command": "make build"
    },
    "vars": {
        "DEFAULT_USER": "cxjava"
    },
    "observability": {
        "logs": {
            "enabled": false,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        }
    }
}